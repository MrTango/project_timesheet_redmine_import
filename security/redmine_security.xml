<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="redmine_backend_company_rule" model="ir.rule">
        <field name="name">Redmine backend: allowed companies</field>
        <field name="model_id" ref="model_redmine_backend"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="redmine_employee_map_company_rule" model="ir.rule">
        <field name="name">Redmine employee map: allowed companies</field>
        <field name="model_id" ref="model_redmine_employee_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="redmine_import_log_company_rule" model="ir.rule">
        <field name="name">Redmine import log: allowed companies</field>
        <field name="model_id" ref="model_redmine_import_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="redmine_import_log_line_company_rule" model="ir.rule">
        <field name="name">Redmine import log detail: allowed companies</field>
        <field name="model_id" ref="model_redmine_import_log_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_manager')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
