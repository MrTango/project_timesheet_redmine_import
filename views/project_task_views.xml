<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form_redmine" model="ir.ui.view">
        <field name="name">project.task.form.redmine</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='extra_info']" position="after">
                <page name="redmine" string="Redmine" groups="project.group_project_manager,base.group_system" attrs="{'invisible': [('redmine_backend_id', '=', False)]}">
                    <group>
                        <field name="redmine_backend_id" readonly="1"/>
                        <field name="redmine_project_id" readonly="1"/>
                        <field name="redmine_issue_id" readonly="1"/>
                        <field name="redmine_updated_on" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
