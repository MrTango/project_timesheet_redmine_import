<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_redmine" model="ir.ui.view">
        <field name="name">project.project.form.redmine</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='settings']" position="after">
                <page name="redmine" string="Redmine" groups="project.group_project_manager,base.group_system">
                    <group>
                        <group string="Project Mapping">
                            <field name="company_id" invisible="1"/>
                            <field name="redmine_backend_id" domain="[('company_id', '=', company_id)]" options="{'no_create_edit': True}"/>
                            <field name="redmine_project_id"/>
                            <field name="redmine_project_identifier"/>
                            <field name="redmine_import_enabled"/>
                            <field name="last_redmine_sync"/>
                        </group>
                        <group string="Issue to Task Synchronization">
                            <field name="redmine_create_tasks"/>
                            <field name="redmine_task_update_policy" attrs="{'invisible': [('redmine_create_tasks', '=', False)], 'required': [('redmine_create_tasks', '=', True)]}"/>
                            <div class="text-muted" colspan="2">
                                Closed Redmine issues never archive or delete Odoo tasks.
                            </div>
                        </group>
                    </group>
                    <group>
                        <button name="action_open_redmine_import_wizard" type="object" string="Import Redmine Hours" class="oe_highlight" attrs="{'invisible': [('redmine_import_enabled', '=', False)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
